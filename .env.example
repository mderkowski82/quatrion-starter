# =============================================================================
# quatrion-starter — Environment variables template
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values — NEVER commit .env to version control
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
PORTAL_DB_USER=portal
PORTAL_DB_PASSWORD=portal

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Client secrets — sync with keycloak/realm-export.json
# DEV: use dev secrets below. PROD: inject from Vault or secrets manager.
KEYCLOAK_CLIENT_ID=quatrion-frontend
KEYCLOAK_CLIENT_SECRET=quatrion-frontend-dev-secret
KEYCLOAK_BACKEND_CLIENT_SECRET=quatrion-backend-dev-secret
KEYCLOAK_REALM=quatrion

# ── Frontend (Auth.js v5) ─────────────────────────────────────────────────────
# DEV: pre-generated value below is safe to use locally.
# PROD: generate your own → openssl rand -hex 32
# WARNING: changing this secret invalidates all existing user sessions (cookies).
AUTH_SECRET=157a15c42038ea7a3e967133b96d8bc0289ae0f92f2e4cafdbce8915b8d61e70
NEXTAUTH_URL=http://localhost:3000

# ── Frontend Docker image ─────────────────────────────────────────────────────
# Pin a specific version or use 'latest' for the most recent build.
# Available tags: https://github.com/mderkowski82/quatrion-saas/pkgs/container/quatrion-portal-frontend
# Format: YYYY.MM.DD-HHmm  (e.g. 2026.03.30-1422)
FRONTEND_VERSION=latest

